---
const { title, issuer, year } = Astro.props;
---
<div class="group relative p-4 border border-black/20 hover:border-black transition-colors cursor-help">
    <div class="absolute -top-2 -right-2 bg-black text-white text-[8px] px-1 opacity-0 group-hover:opacity-100 transition-opacity">
        VERIFIED_OK
    </div>
    <p class="font-mono text-[9px] uppercase text-zinc-400">{issuer} // {year}</p>
    <h4 class="text-lg font-bold uppercase leading-tight mt-1">{title}</h4>
    
    <div class="absolute inset-0 flex items-center justify-center opacity-[0.03] group-hover:opacity-[0.07] pointer-events-none transition-opacity">
        <span class="text-4xl font-black rotate-12">OFFICIAL</span>
    </div>
</div>