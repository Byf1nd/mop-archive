---
import '../styles/global.css';
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=1" />
		
		<title>{title || "MÖP ARCHIVE | Paula Mendez Ortega"}</title>
		<meta name="description" content="BI, Data Science & Web Foundry. Portafolio editorial de Paula Mendez Ortega." />
		<meta name="keywords" content="Business Intelligence, Data Science, Web Development, Astro, React, Python, Merida, Global" />

		<meta property="og:title" content="MÖP ARCHIVE | Issue 01" />
		<meta property="og:description" content="Explora el archivo técnico de Paula Mendez Ortega." />
		<meta property="og:type" content="website" />
		
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#F5F5F3] selection:bg-[#FF3E00] selection:text-white antialiased">
		<slot />
	</body>
</html>