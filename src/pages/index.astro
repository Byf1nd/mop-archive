                <div>
                    <span class="font-mono text-[10px] text-zinc-400 uppercase tracking-widest">[ CAPABILITY_MANIFEST_02 ]</span>
                    <h2 id="manifest-title" class="text-4xl font-black uppercase tracking-tighter italic mt-1">{content.es.manifestTitle}</h2>
                </div>
                <div id="manifest-sub" class="font-mono text-xs bg-zinc-100 border border-black px-3 py-1 uppercase italic">
                    {content.es.manifestSub}
                </div>
            </div>

            <div class="max-w-3xl font-mono text-sm md:text-base leading-relaxed mb-12">
