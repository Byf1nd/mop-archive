---
import Layout from '../layouts/Layout.astro';
import ProjectStack from '../components/ProjectStack.jsx';
import TicTacToe from '../components/TicTacToe.jsx';
import Credential from '../components/Credential.astro';
import ServiceTicket from '../components/ServiceTicket.jsx';

const content = {
  es: {
	specTitle1: "Inteligencia de Negocios",
    specDesc1: "Arquitectura de datos para retail. Reducción de fricción operativa mediante dashboards de toma de decisiones en tiempo real.",
    specTitle2: "Automatización & Bots",
    specDesc2: "Sincronización masiva (+1.1M registros). Scrapers serverless y bots de alertas integrados en Telegram/Azure.",
    specTitle3: "Fundición Web",
    specDesc3: "Interfaces editoriales de alto rendimiento. Desarrollo con Astro y React enfocado en UX internacional.",
    role: "BI / DS / WEB / BOTS",
    status: "STATUS: DISPONIBLE_GLOBAL_2026",
    abstractTitle: "Las Colecciones",
    abstractText: "Una intersección cruda entre la inteligencia de datos y la arquitectura web. Explora el archivo arrastrando las evidencias.",
    servicesTitle: "Servicios Seleccionados",
    validation: "Validación",
    play: "Juega mientras carga...",
    impactTitle: "Impacto en Cifras",
    h1: "Eficiencia Client Service Prototipo",
    h1_val: "41.67% Contact Rate",
    h2: "Precisión Médica (AI)",
    h2_val: "0.7120 ROC-AUC",
    h3: "Escalabilidad de Datos",
    h3_val: "+1.1M Records",
    h4: "Automatización Fashion",
    h4_val: "100% Serverless",
    statement: '"Mi enfoque no es solo el código, sino la reducción de fricción operativa y la predicción de comportamientos mediante inteligencia cultural."'
  },
  en: {
	specTitle1: "Business Intelligence",
    specDesc1: "Data architecture for retail. Reducing operational friction through real-time decision-making dashboards.",
    specTitle2: "Automation & Bots",
    specDesc2: "Massive synchronization (+1.1M records). Serverless scrapers and alert bots integrated into Telegram/Azure.",
    specTitle3: "Web Foundry",
    specDesc3: "High-performance editorial interfaces. Astro and React development focused on international UX.",
    role: "BI / DS / WEB / BOTS",
    status: "STATUS: AVAILABLE_GLOBAL_2026",
    abstractTitle: "The Collections",
    abstractText: "A raw intersection between data intelligence and web architecture. Explore the archive by dragging the evidence.",
    servicesTitle: "Selected Services",
    validation: "Validation",
    play: "Play while data loads...",
    impactTitle: "Impact in Figures",
    h1: "Prototype Client Service Efficiency",
    h1_val: "41.67% Contact Rate",
    h2: "Medical Precision (AI)",
    h2_val: "0.7120 ROC-AUC",
    h3: "Data Scalability",
    h3_val: "+1.1M Records",
    h4: "Fashion Automation",
    h4_val: "100% Serverless",
    statement: '"My focus is not just code, but reducing operational friction and predicting behaviors through cultural intelligence."'
  }
};
---

<Layout title="MOP ARCHIVE | Issue 01">
    <div class="fixed inset-0 pointer-events-none opacity-[0.03] z-[100] noise-bg"></div>

    <main class="p-4 md:p-10 relative max-w-[1600px] mx-auto overflow-x-hidden">
	   <nav class="flex justify-between items-start mb-8 relative z-[110]">
	       <div id="status-tag" class="bg-yellow-300 border-2 border-black p-2 font-mono text-[10px] font-bold shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] uppercase">
		       {content.es.status}
			</div>

			<button id="lang-btn" class="bg-black text-white px-3 py-1 cursor-pointer hover:bg-[#FF3E00] transition-colors font-mono text-[10px] font-bold border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
			    EN / ES
			</button>
		</nav>
        
        <header class="border-b-4 border-black pb-8 mb-16 relative">
            <div class="mb-12">
                <h1 class="text-[18vw] md:text-[16vw] font-black leading-[0.85] uppercase tracking-tighter -ml-1 overflow-visible">
                    <span class="block">M<span class="relative inline-block">O<span class="absolute -top-[0.2em] left-1/2 -translate-x-1/2 text-[0.4em] leading-none">..</span></span>P</span>
                    <span class="text-transparent block" style="-webkit-text-stroke: 1.5px black; text-stroke: 1.5px black; font-family: sans-serif;">
                       ARCHIVE
                    </span>
                </h1>
            </div>

            <div class="flex justify-end">
                <div class="w-full md:w-80 flex flex-col font-mono text-[10px] md:text-xs uppercase bg-white border-2 border-black p-4 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]">
                    <div class="border-b border-black mb-2 pb-1 flex justify-between opacity-50 text-[8px]">
                       <span>Identification_File</span>
                       <span>v.2026</span>
                    </div>
                    <p class="border-b border-black py-1 font-bold italic">NAME: PAULA MENDEZ ORTEGA</p>
                    <p id="role-text" class="border-b border-black py-1 tracking-tighter">{content.es.role}</p>
                    <div class="flex justify-between items-center pt-2">
                        <span class="italic opacity-50">EDITION: 24.4.0</span>
                    </div>
                </div>
            </div>
        </header>

        <section class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-32">
            <div class="lg:col-span-4 relative pt-10"> <div class="bg-white border border-black p-8 rotate-[-2deg] shadow-2xl relative max-w-sm mx-auto z-20">
                <div class="absolute -top-6 left-1/2 -translate-x-1/2 w-24 h-10 bg-zinc-400/20 backdrop-blur-sm border border-black/5 rotate-1 z-30"></div>
                    <p class="font-mono text-[10px] text-zinc-400 mb-6 tracking-widest uppercase">Abstract_01.txt</p>
                    <h2 id="abstract-title" class="text-4xl md:text-5xl font-bold uppercase leading-[0.9] mb-6 italic border-b border-black/40 pb-2">
					    {content.es.abstractTitle}
					</h2>	
                    <p id="abstract-text" class="text-sm leading-tight font-medium">{content.es.abstractText}</p>
                    <div class="mt-10 font-mono text-[10px] flex justify-between items-center opacity-40">
                        <span>(SCROLL_TO_DISCOVER)</span>
                        <span class="text-xl animate-bounce">↓</span>
                    </div>
                </div>
            </div>
            <div class="lg:col-span-8 flex justify-center items-center min-h-[500px]">
                <ProjectStack client:load /> 
            </div>
        </section>

        <section class="mt-20 grid grid-cols-1 md:grid-cols-2 gap-1 border-2 border-black bg-black overflow-hidden mb-32">
            <div class="bg-white p-8">
                <span class="font-mono text-[10px] uppercase opacity-40 italic tracking-widest">Case_Study_Hitos</span>
                <h3 id="impact-title" class="text-4xl font-black uppercase mt-4 mb-6">{content.es.impactTitle}</h3>
                <ul class="space-y-6 font-mono text-xs uppercase">
                    <li class="flex justify-between border-b border-zinc-200 pb-2">
                        <span id="h1">{content.es.h1}</span>
                        <span class="font-bold text-[#FF3E00]">{content.es.h1_val}</span>
                    </li>
                    <li class="flex justify-between border-b border-zinc-200 pb-2">
                        <span id="h2">{content.es.h2}</span>
                        <span class="font-bold text-[#FF3E00]">{content.es.h2_val}</span>
                    </li>
                    <li class="flex justify-between border-b border-zinc-200 pb-2">
                        <span id="h3">{content.es.h3}</span>
                        <span class="font-bold text-[#FF3E00]">{content.es.h3_val}</span>
                    </li>
                    <li class="flex justify-between">
                        <span id="h4">{content.es.h4}</span>
                        <span class="font-bold text-[#FF3E00]">{content.es.h4_val}</span>
                    </li>
                </ul>
            </div>
            <div class="bg-zinc-100 p-8 flex flex-col justify-center italic">
                <p id="statement" class="text-2xl leading-tight">
                    {content.es.statement}
                </p>
                <span class="mt-6 font-mono text-[10px]">— MÖP STATEMENT_2026</span>
            </div>
        </section>

		<section class="mt-20 md:mt-32 grid grid-cols-1 lg:grid-cols-12 gap-0 border-4 border-black overflow-hidden bg-white shadow-[10px_10px_0px_0px_rgba(0,0,0,1)]">
            <div class="lg:col-span-4 p-8 md:p-10 border-b lg:border-b-0 lg:border-r-4 border-black hover:bg-[#FF3E00] hover:text-white transition-all group cursor-pointer">
                <span class="font-mono text-[10px] mb-6 block opacity-50 underline uppercase tracking-widest">Specialty_01</span>
                <h3 id="spec-t1" class="text-3xl md:text-4xl font-black uppercase mb-6 leading-[0.9] italic">
                    {content.es.specTitle1}
                </h3>
                <p id="spec-d1" class="text-sm font-mono leading-tight group-hover:italic transition-all">
                    {content.es.specDesc1}
                </p>
                <div class="mt-8 font-mono text-[8px] border-t border-current pt-2 uppercase opacity-60 italic tracking-widest">
                    Tech: Streamlit / SQL / Tableau
                </div>
            </div>

            <div class="lg:col-span-4 p-8 md:p-10 border-b lg:border-b-0 lg:border-r-4 border-black hover:bg-black hover:text-white transition-all group cursor-pointer">
                <span class="font-mono text-[10px] mb-6 block opacity-50 underline uppercase tracking-widest">Specialty_02</span>
                <h3 id="spec-t2" class="text-3xl md:text-4xl font-black uppercase mb-6 leading-[0.9] italic">
                    {content.es.specTitle2}
                </h3>
                <p id="spec-d2" class="text-sm font-mono leading-tight group-hover:italic transition-all">
                    {content.es.specDesc2}
                </p>
                <div class="mt-8 font-mono text-[8px] border-t border-current pt-2 uppercase opacity-60 italic tracking-widest">
                    Tech: Playwright / Python / Azure
                </div>
            </div>

            <div class="lg:col-span-4 p-8 md:p-10 border-b lg:border-b-0 border-black hover:bg-yellow-300 hover:text-black transition-all group cursor-pointer">
                <span class="font-mono text-[10px] mb-6 block opacity-50 underline uppercase tracking-widest">Specialty_03</span>
                <h3 id="spec-t3" class="text-3xl md:text-4xl font-black uppercase mb-6 leading-[0.9] italic">
                    {content.es.specTitle3}
                </h3>
                <p id="spec-d3" class="text-sm font-mono leading-tight group-hover:italic transition-all">
                    {content.es.specDesc3}
                </p>
                <div class="mt-8 font-mono text-[8px] border-t border-current pt-2 uppercase opacity-60 italic tracking-widest">
                    Tech: Astro / React / Tailwind
                </div>
            </div>
        </section>

        <section class="mt-32 mb-32 border-y-2 border-black py-4 bg-black text-white overflow-hidden rotate-1">
            <div class="flex gap-12 animate-marquee-fast whitespace-nowrap font-mono text-[10px] uppercase tracking-[0.3em]">
                <span>SAMSUNG_INNOVATION_CAMPUS //</span>
                <span>GOOGLE_CYBERSECURITY //</span>
                <span>CISCO_PYTHON_ESSENTIALS //</span>
                <span>ORACLE_DATABASE_FOUNDATIONS //</span>
                <span>IBM_AI_HONORS //</span>
                <span>KAIST_AI_CODING //</span>
                <span>K-INFLUENCER_ACADEMY //</span>
                <span>GOOGLE_CLOUD_GEN_AI //</span>
                <span>ALURA_LATAM_JS //</span>
                <span>CENEVAL_ADVANCED_LEADERSHIP //</span>
            </div>
        </section>

        <section class="mt-40 mb-20">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-12">
                <p class="font-mono text-xs uppercase tracking-[0.5em] mb-4 md:mb-0 text-zinc-500 italic">Freelance_Inquiry_Desk</p>
                <div class="h-[2px] bg-black flex-1 mx-8 hidden md:block opacity-20"></div>
                <h3 id="services-title" class="text-2xl font-bold uppercase italic tracking-tighter">{content.es.servicesTitle}</h3>
            </div>
            <ServiceTicket client:load />
        </section>

        <section class="mt-32 grid grid-cols-1 lg:grid-cols-12 gap-12 border-t-4 border-black pt-16 mb-20">
            <div class="lg:col-span-8">
                <div class="flex items-baseline gap-4 mb-10 flex-wrap"> <h3 id="validation-title" class="text-5xl md:text-7xl font-black uppercase tracking-tighter italic leading-none">
				        {content.es.validation}
					</h3>
                    <span class="font-mono text-xs opacity-40">[LIST_01]</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <Credential title="Liderazgo SIC - Avanzado" issuer="CENEVAL" year="2026" />
                    <Credential title="Samsung Innovation Campus" issuer="SAMSUNG" year="2026" />
                    <Credential title="Python Essentials 2" issuer="CISCO" year="2024" />
                    <Credential title="Database Foundations" issuer="ORACLE" year="2025" />
                    <Credential title="Intro to GenAI" issuer="GOOGLE CLOUD" year="2023" />
                    <Credential title="UX Design" issuer="CT" year="2025" />
                </div>
            </div>

            <div class="lg:col-span-4 flex flex-col items-center lg:items-end justify-center py-10">
                <div class="relative">
                    <TicTacToe client:load />
                    <div class="absolute -top-12 -left-12 hidden xl:block pointer-events-none">
                        <span id="play-text" class="font-mono text-[10px] uppercase block mb-1">{content.es.play}</span>
                        <svg width="40" height="40" viewBox="0 0 40 40" class="rotate-45">
                            <path d="M10 30 L30 10 M30 10 L20 10 M30 10 L30 20" stroke="black" fill="none" stroke-width="2"/>
                        </svg>
                    </div>
                </div>
            </div>
        </section>


		<footer class="mt-40 border-t-4 border-black pt-10 pb-20 flex flex-col md:flex-row justify-between items-start gap-10 font-mono text-[10px] uppercase">
            <div class="space-y-2">
                <p class="font-bold text-base tracking-tighter">MÖP_ARCHIVE_2026</p>
                <p class="opacity-50">All rights reserved // Issue 01</p>
				<div class="pt-4">
				    <span class="bg-black text-white px-2 py-1">BUILD_0.9.4_STABLE</span>
                </div>
			</div>
    
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-12 w-full md:w-auto">
                <div class="flex flex-col">
                    <span class="opacity-40 mb-3 underline text-[8px] tracking-[0.2em]">Direct_Inquiry</span>
                    <a href="mailto:paula@moparchive.com" class="hover:text-[#FF3E00] transition-colors font-bold text-xs lowercase">
					    paula@moparchive.com
					</a>
                </div>

                <div class="flex flex-col">
                    <span class="opacity-40 mb-3 underline text-[8px] tracking-[0.2em]">Social_Nodes</span>
                    <div class="flex flex-col gap-2">
					    <a href="https://www.instagram.com/kroma_code?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw==" target="_blank" class="hover:underline flex items-center gap-1">
                            <span class="w-2 h-2 bg-pink-500 rounded-full"></span> Instagram
                        </a>
                        <a href="https://www.linkedin.com/in/paula-mendez-ortega/" target="_blank" class="hover:underline flex items-center gap-1">
						    <span class="w-2 h-2 bg-blue-600 rounded-full"></span> LinkedIn
                        </a>
                        <a href="https://github.com/Byf1nd" target="_blank" class="hover:underline flex items-center gap-1">
                            <span class="w-2 h-2 bg-zinc-800 rounded-full"></span> GitHub
                        </a>
					</div>
                </div>

				<div class="flex flex-col">
                    <span class="opacity-40 mb-3 underline text-[8px] tracking-[0.2em]">Location</span>
                    <p class="font-bold italic">Mérida, MX // Remote_Global</p>
                </div>
            </div>
    
            <div class="text-right self-end md:self-auto uppercase italic opacity-20 hidden lg:block">
               End_of_Transmission
            </div>
        </footer>

    </main>
</Layout>

<script define:vars={{ content }}>
    let currentLang = 'es';
    const btn = document.getElementById('lang-btn');

    const elements = {
        status: document.getElementById('status-tag'),
        role: document.getElementById('role-text'),
        abstractTitle: document.getElementById('abstract-title'),
        abstractText: document.getElementById('abstract-text'),
        servicesTitle: document.getElementById('services-title'),
        validation: document.getElementById('validation-title'),
        play: document.getElementById('play-text'),
        impactTitle: document.getElementById('impact-title'),
        h1: document.getElementById('h1'),
        h2: document.getElementById('h2'),
        h3: document.getElementById('h3'),
        h4: document.getElementById('h4'),
        statement: document.getElementById('statement'), // <- Coma aquí
        specTitle1: document.getElementById('spec-t1'),
        specDesc1: document.getElementById('spec-d1'),
        specTitle2: document.getElementById('spec-t2'),
        specDesc2: document.getElementById('spec-d2'),
        specTitle3: document.getElementById('spec-t3'),
        specDesc3: document.getElementById('spec-d3')
    };

    btn.addEventListener('click', () => {
        currentLang = currentLang === 'es' ? 'en' : 'es';
        
        Object.keys(elements).forEach(key => {
            if(elements[key] && content[currentLang][key]) {
                elements[key].innerText = content[currentLang][key];
            }
        });
		
		btn.innerText = currentLang === 'es' ? 'EN / ES' : 'ES / EN';
		window.dispatchEvent(new CustomEvent('langChange', { detail: currentLang }));
	});
		
</script>

<style>
    .noise-bg {
        background-image: url("https://grainy-gradients.vercel.app/noise.svg");
        filter: contrast(170%) brightness(1000%);
    }
    .text-outline { -webkit-text-stroke: 2px black; }
    .text-outline:hover { -webkit-text-fill-color: black; -webkit-text-stroke: 2px transparent; }
    
    :global(body) { 
        background-color: #F5F5F3; 
        overflow-x: hidden; 
    }

    @keyframes marquee-fast {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }
    .animate-marquee-fast {
        display: flex;
        width: max-content;
        animation: marquee-fast 30s linear infinite;
    }
</style>