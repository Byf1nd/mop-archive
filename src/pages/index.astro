                </div>
            </div>

            <div class="lg:col-span-4 p-8 md:p-10 border-b lg:border-b-0 border-black hover:bg-yellow-300 hover:text-black transition-all group cursor-pointer">
                <span class="font-mono text-[10px] mb-6 block opacity-50 underline uppercase tracking-widest">Specialty_03</span>
                <h3 id="spec-t3" class="text-3xl md:text-4xl font-black uppercase mb-6 leading-[0.9] italic">
                    {content.es.specTitle3}
                </h3>
                <p id="spec-d3" class="text-sm font-mono leading-tight group-hover:italic transition-all">
                    {content.es.specDesc3}
                </p>
                <div class="mt-8 font-mono text-[8px] border-t border-current pt-2 uppercase opacity-60 italic tracking-widest">
                    Tech: Astro / React / Tailwind
                </div>
            </div>
        </section>

        <section class="mt-32 mb-32 border-y-2 border-black py-4 bg-black text-white overflow-hidden rotate-1">
            <div class="flex gap-12 animate-marquee-fast whitespace-nowrap font-mono text-[10px] uppercase tracking-[0.3em]">
                <span>SAMSUNG_INNOVATION_CAMPUS //</span>
                <span>GOOGLE_CYBERSECURITY //</span>
                <span>CISCO_PYTHON_ESSENTIALS //</span>
                <span>ORACLE_DATABASE_FOUNDATIONS //</span>
                <span>IBM_AI_HONORS //</span>
                <span>KAIST_AI_CODING //</span>
                <span>K-INFLUENCER_ACADEMY //</span>
                <span>GOOGLE_CLOUD_GEN_AI //</span>
                <span>ALURA_LATAM_JS //</span>
                <span>CENEVAL_ADVANCED_LEADERSHIP //</span>
            </div>
        </section>

        <section class="mt-40 mb-20">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-12">
