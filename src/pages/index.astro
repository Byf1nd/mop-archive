                        <div>
                            <span class="font-mono text-xs font-bold text-[#FF3E00]">01 / LAYER_DATA</span>
                            <h4 id="c1-title" class="text-lg font-black uppercase my-2">{content.es.c1Title}</h4>
                            <p id="c1-desc" class="text-xs font-mono leading-tight opacity-80">{content.es.c1Desc}</p>
                        </div>
                    </div>

                    <div class="bg-white border-2 border-black p-6 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
