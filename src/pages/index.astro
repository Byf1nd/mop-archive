                            <p id="c2-desc" class="text-xs font-mono leading-tight opacity-80">{content.es.c2Desc}</p>
                        </div>
                    </div>

                    <div class="bg-white border-2 border-black p-6 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] flex flex-col justify-between">
                        <div>
                            <span class="font-mono text-xs font-bold text-yellow-600">03 / LAYER_UX_VALUE</span>
                            <h4 id="c3-title" class="text-lg font-black uppercase my-2">{content.es.c3Title}</h4>
                            <p id="c3-desc" class="text-xs font-mono leading-tight opacity-80">{content.es.c3Desc}</p>
                        </div>
                    </div>
                </div>

                <div class="border-2 border-black bg-white p-4 md:p-8">
                    <span class="font-mono text-[9px] opacity-40 block mb-4 uppercase tracking-widest">[ REVENUE_LOGIC_FLOW.PNG ]</span>
                    
                    <div class="flex flex-col md:flex-row items-center justify-around gap-6 text-center font-mono text-xs py-4">
                        <div class="p-4 border border-dashed border-black/30 bg-zinc-50 w-full md:w-1/4">
                            <span class="font-bold block text-[#FF3E00]">INPUT VARIABLES</span>
